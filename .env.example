# NextAuth
AUTH_SECRET=                       # `npx auth secret` to generate
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails allowed to sign in. Leave empty to allow any
# Google account (NOT recommended in production).
ALLOWED_EMAILS=

# Vercel Blob (auto-injected on Vercel; pull locally with `vercel env pull`).
BLOB_READ_WRITE_TOKEN=

# Optional key namespace prefix. Use `dev/` locally to avoid colliding
# with prod data; leave empty in prod.
BLOB_PREFIX=

# CLI-only: token for the lagrandemelee.midi-olympique.fr API. The
# extension captures this from the live site so end-users don't need it.
TOP14_TOKEN=

# CLI-only: your userId (Google `sub`) — the CLI writes the snapshot
# to `players/{BLOB_PREFIX}{USER_ID}.json` so it lands in the same blob
# the app reads for you. Find yours by signing into the app and hitting
# `/api/me`.
USER_ID=
